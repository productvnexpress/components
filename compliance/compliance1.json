{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "compliance1",
  "title": "Compliance",
  "description": "A two-column component featuring compliance and security features, highlighted with badges, images, and outlined sections for automated audit trails, monitoring, and reporting.",
