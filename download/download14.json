{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "download14",
  "title": "Download 14 - Multi-platform desktop download with installer tabs and formats",
  "description": "This component provides users with the ability to download a desktop application tailored to their operating system, including Windows, macOS, and Linux, with options to choose from multiple file formats. It also includes tabs for version information, platform requirements, setup guidance, and links for detailed resources, making it versatile for download and installation needs.",
  "dependencies": [
    "lucide-react",
    "react-icons"
  ],
  "registryDependencies": [
    "badge",
    "button",
    "button-group",
    "select",
    "tabs"
  ],
  "files": [
    {
      "path": "block/download14/download14.tsx",
      "content": "import { ArrowUpRight, Download } from \"lucide-react\";\nimport { FaApple, FaLinux, FaWindows } from \"react-icons/fa\";\n\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport { ButtonGroup } from \"@/components/ui/button-group\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\n\nconst Download14 = () => {\n  return (\n    <section className=\"py-32\">\n      <div className=\"container\">\n        <img\n          src=\"https://deifkwefumgah.cloudfront.net/shadcnblocks/block/block-2.svg\"\n          alt=\"logo\"\n          className=\"mb-10 w-32 lg:hidden dark:invert\"\n        />\n        <div className=\"flex flex-col-reverse gap-10 lg:flex-row\">\n          <div className=\"w-full border-t pt-10 lg:max-w-sm lg:border-t-0 lg:border-r lg:pt-0 lg:pr-10\">\n            <img\n              src=\"https://deifkwefumgah.cloudfront.net/shadcnblocks/block/block-2.svg\"\n              alt=\"logo\"\n              className=\"hidden w-32 lg:block dark:invert\"\n            />\n            <dl className=\"space-y-2 text-sm text-muted-foreground lg:mt-6\">\n              <div className=\"flex items-center justify-between gap-4\">\n                <dt className=\"font-medium text-foreground\">Version</dt>\n                <dd>3.4.1</dd>\n              </div>\n              <div className=\"flex items-center justify-between gap-4\">\n                <dt className=\"font-medium text-foreground\">Build</dt>\n                <dd>304.18290.6</dd>\n              </div>\n              <div className=\"flex items-center justify-between gap-4\">\n                <dt className=\"font-medium text-foreground\">Release date</dt>\n                <dd>12 Sep 2025</dd>\n              </div>\n            </dl>\n            <ul className=\"mt-6 space-y-2 text-sm text-muted-foreground\">\n              <li>\n                <a\n                  href=\"#\"\n                  className=\"flex items-center gap-1 text-primary hover:underline\"\n                >\n                  View version details <ArrowUpRight className=\"size-3.5\" />\n                </a>\n              </li>\n              <li>\n                <a\n                  href=\"#\"\n                  className=\"flex items-center gap-1 text-primary hover:underline\"\n                >\n                  Platform requirements <ArrowUpRight className=\"size-3.5\" />\n                </a>\n              </li>\n              <li>\n                <a\n                  href=\"#\"\n                  className=\"flex items-center gap-1 text-primary hover:underline\"\n                >\n                  Setup and installation guide\n                  <ArrowUpRight className=\"size-3.5\" />\n                </a>\n              </li>\n              <li>\n                <a\n                  href=\"#\"\n                  className=\"flex items-center gap-1 text-primary hover:underline\"\n                >\n                  Previous versions and channels\n                  <ArrowUpRight className=\"size-3.5\" />\n                </a>\n              </li>\n              <li>\n                <a\n                  href=\"#\"\n                  className=\"flex items-center gap-1 text-primary hover:underline\"\n                >\n                  Included third‑party components\n                  <ArrowUpRight className=\"size-3.5\" />\n                </a>\n              </li>\n            </ul>\n          </div>\n          <div className=\"flex-1\">\n            <div className=\"flex items-center gap-3\">\n              <Badge variant=\"secondary\" className=\"rounded-full px-3 py-1\">\n                Release 3.4.1\n              </Badge>\n              <span className=\"text-sm text-muted-foreground\">\n                Stable channel\n              </span>\n            </div>\n            <h1 className=\"mt-4 text-3xl font-semibold lg:text-4xl\">\n              Download the desktop app\n            </h1>\n            <p className=\"mt-3 text-muted-foreground lg:text-lg\">\n              Get the latest version of the application for your operating\n              system.\n            </p>\n            <Tabs defaultValue=\"windows\" className=\"mt-6\">\n              <TabsList className=\"mb-4\">\n                <TabsTrigger value=\"windows\">\n                  <FaWindows />\n                  Windows\n                </TabsTrigger>\n                <TabsTrigger value=\"macos\">\n                  <FaApple />\n                  macOS\n                </TabsTrigger>\n                <TabsTrigger value=\"linux\">\n                  <FaLinux />\n                  Linux\n                </TabsTrigger>\n              </TabsList>\n              <TabsContent value=\"windows\">\n                <ButtonGroup>\n                  <Button variant=\"outline\">Download</Button>\n                  <Select defaultValue=\"exe\">\n                    <SelectTrigger>\n                      <SelectValue />\n                    </SelectTrigger>\n                    <SelectContent>\n                      <SelectItem value=\"exe\">\n                        <Download />\n                        .exe (Windows)\n                      </SelectItem>\n                      <SelectItem value=\"zip\">\n                        <Download />\n                        .zip (Windows)\n                      </SelectItem>\n                      <SelectItem value=\"msi\">\n                        <Download />\n                        .msi (Windows)\n                      </SelectItem>\n                    </SelectContent>\n                  </Select>\n                </ButtonGroup>\n              </TabsContent>\n              <TabsContent value=\"macos\">\n                <ButtonGroup>\n                  <Button variant=\"outline\">Download</Button>\n                  <Select defaultValue=\"dmg\">\n                    <SelectTrigger>\n                      <SelectValue />\n                    </SelectTrigger>\n                    <SelectContent>\n                      <SelectItem value=\"dmg\">\n                        <Download />\n                        .dmg (macOS)\n                      </SelectItem>\n                      <SelectItem value=\"pkg\">\n                        <Download />\n                        .pkg (macOS)\n                      </SelectItem>\n                      <SelectItem value=\"tar.gz\">\n                        <Download />\n                        .tar.gz (macOS)\n                      </SelectItem>\n                    </SelectContent>\n                  </Select>\n                </ButtonGroup>\n              </TabsContent>\n              <TabsContent value=\"linux\">\n                <ButtonGroup>\n                  <Button variant=\"outline\">Download</Button>\n                  <Select defaultValue=\"tar.gz\">\n                    <SelectTrigger>\n                      <SelectValue />\n                    </SelectTrigger>\n                    <SelectContent>\n                      <SelectItem value=\"tar.gz\">\n                        <Download />\n                        .tar.gz (Linux)\n                      </SelectItem>\n                      <SelectItem value=\"deb\">\n                        <Download />\n                        .deb (Linux)\n                      </SelectItem>\n                    </SelectContent>\n                  </Select>\n                </ButtonGroup>\n              </TabsContent>\n            </Tabs>\n            <a\n              href=\"#\"\n              className=\"mt-12 flex max-w-xl items-center gap-2 rounded-lg border px-4 py-3 hover:border-primary\"\n            >\n              <img\n                src=\"https://deifkwefumgah.cloudfront.net/shadcnblocks/block/block-2.svg\"\n                alt=\"logo\"\n                className=\"w-12 dark:invert\"\n              />\n              <p className=\"font-medium lg:text-lg\">\n                Use the companion app to manage downloads and keep future\n                updates effortless\n              </p>\n            </a>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nexport { Download14 };\n",
      "type": "registry:block"
    }
  ],
  "type": "registry:block"
}