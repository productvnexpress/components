{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "feature107",
  "title": "Feature",
  "description": "A component featuring a badge and six linked blocks showcasing tools, each with an image, title, description, and a \"Visit Website\" call-to-action.",
  "dependencies": [
    "lucide-react",
    "clsx",
