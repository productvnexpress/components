{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "feature41",
  "title": "Feature",
  "description": "A component with a title and a 5-column layout that displays 4 colored blocks, each containing a location name and address.",
  "dependencies": [
    "clsx",
    "tailwind-merge"
